# Copy to .env and fill in. EXPO_PUBLIC_* values are embedded in the app bundle,
# so only put PUBLIC-safe values here (Supabase anon/publishable key is fine).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Secrets (Gemini, service-role, etc.) are NEVER put here. They live only as
# Supabase Edge Function secrets:
#   supabase secrets set GEMINI_API_KEY=...
