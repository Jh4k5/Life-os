# Copy this file to `.env` (that's the only env setup needed):
#   cp .env.example .env
#
# EXPO_PUBLIC_* values are embedded in the app bundle, so ONLY public-safe
# values belong here. The Supabase anon/publishable key IS public by design —
# it's protected by Row-Level Security. These are the real project values:
EXPO_PUBLIC_SUPABASE_URL=https://jlwmpyhiitgdklrbmxrh.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_kMAoMJp_ReDLfrMwrYmNBw_NL5fho6I

# Secrets (Gemini, service-role, etc.) are NEVER put here — they would ship in
# the bundle. They live only as Supabase Edge Function secrets:
#   supabase secrets set GEMINI_API_KEY=...
